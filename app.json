{
  "expo": {
    "name": "EventEase",
    "slug": "eventease",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "src/assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "src/assets/images/adaptive-icon.png",
        "monochromeImage": "src/assets/images/monochrome-icon.png",
        "backgroundColor": "#071017"
      }
    },
    "web": {
      "favicon": "src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071017",
          "image": "src/assets/images/splash-icon.png",
          "imageWidth": 280
        }
      ],
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autoriser EventEase à utiliser votre position pour calculer la distance jusqu’aux événements."
        }
      ],
      "expo-status-bar"
    ]
  }
}
